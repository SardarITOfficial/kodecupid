{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "db:generate": "prisma generate",
    "db:diff:init": "prisma migrate diff --from-empty --to-schema ./prisma/schema.prisma --script",
    "db:diff:next": "prisma migrate diff --from-config-datasource --to-schema ./prisma/schema.prisma --script",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@kodecupid/shared": "workspace:*",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "12.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "twilio": "6.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "12.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
