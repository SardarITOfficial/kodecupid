{
  "name": "@kodecupid/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node init && tsc -p tsconfig.json",
    "dev": "node init && tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"console.log('shared: covered by apps/api tests')\""
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
